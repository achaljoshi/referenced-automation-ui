{
  "name": "@automation/referenced-automation-ui",
  "version": "1.0.0",
  "description": "Reusable Playwright UI automation framework: an actions layer covering navigation, element interaction, waits, frames/tabs/downloads, and network mocking; accessibility-first locators (getByRole and friends); and assertions wrapping Playwright's full expect() API - all logged, all composed via plain factory functions, no base classes.",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist *.tgz",
    "lint": "eslint . --ext .ts",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "pretest": "npm run build",
    "prepack": "npm run build",
    "install:browsers": "playwright install --with-deps chromium firefox webkit",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open"
  },
  "dependencies": {
    "@automation/referenced-automation-utils": "file:../shared-packages/automation-referenced-automation-utils-1.0.0.tgz",
    "@axe-core/playwright": "^4.13.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@automation/referenced-automation-api": "file:../shared-packages/automation-referenced-automation-api-1.0.0.tgz",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "@types/smtp-server": "^3.5.13",
    "@types/ssh2": "^1.15.5",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "allure-commandline": "^2.32.0",
    "allure-playwright": "^3.0.9",
    "eslint": "^8.57.1",
    "rimraf": "^6.0.1",
    "smtp-server": "^3.19.3",
    "ssh2": "^1.17.0",
    "typescript": "^5.7.3"
  }
}
