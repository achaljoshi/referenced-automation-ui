# Committed settings for ENV=stage: no secrets (those go in .env.stage.local - template .env.local.example). Every key is explained in .env.example.
# The ENV line below is informational: the environment is chosen with ENV in the shell or CI, never from a file.
# LOG_LEVEL below has no effect from a file either: the logger reads only the real environment (set it in the shell or CI).
ENV=stage
LOG_LEVEL=debug
BASE_URL=https://stage.example.com
HEADLESS=true
BROWSER=chromium
