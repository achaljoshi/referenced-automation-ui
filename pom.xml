<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.company.automation</groupId>
    <artifactId>referenced-automation-ui</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Referenced Automation UI Framework</name>
    <description>
        Enterprise reference automation framework (Selenium + Cucumber + Java + Maven).
        Publish this artifact to Nexus and add it as a dependency in any Maven project to
        reuse its drivers, base classes, reporting, logging, retry and Cucumber glue code
        the same way you would with any other library.
    </description>
    <url>https://github.com/achaljoshi/referenced-automation-ui</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>

        <!-- ===== Version properties (bump here, nowhere else) ===== -->
        <selenium.version>4.46.0</selenium.version>
        <webdrivermanager.version>6.3.4</webdrivermanager.version>
        <cucumber.version>7.34.6</cucumber.version>
        <junit.jupiter.version>5.14.4</junit.jupiter.version>
        <junit.platform.version>1.14.4</junit.platform.version>
        <extent.adapter.version>1.14.0</extent.adapter.version>
        <allure.version>2.35.4</allure.version>
        <slf4j.version>2.0.17</slf4j.version>
        <log4j.version>2.26.1</log4j.version>
        <jackson.version>2.22.1</jackson.version>
        <commons.io.version>2.18.0</commons.io.version>

        <maven.surefire.version>3.5.6</maven.surefire.version>
        <maven.compiler.plugin.version>3.15.0</maven.compiler.plugin.version>
        <maven.source.plugin.version>3.3.1</maven.source.plugin.version>
        <maven.jar.plugin.version>3.4.2</maven.jar.plugin.version>
        <maven.resources.plugin.version>3.3.1</maven.resources.plugin.version>
        <maven.deploy.plugin.version>3.1.4</maven.deploy.plugin.version>
        <versions.plugin.version>2.18.0</versions.plugin.version>
        <aspectj.version>1.9.25.1</aspectj.version>

        <!-- Overridable at runtime: mvn test -Dbrowser=chrome -Denv=qa -Dheadless=true -->
        <browser>chrome</browser>
        <env>qa</env>
        <headless>true</headless>

        <argLine>
            -javaagent:"${settings.localRepository}/org/aspectj/aspectjweaver/${aspectj.version}/aspectjweaver-${aspectj.version}.jar"
        </argLine>
    </properties>

    <!-- ===================================================================
         Dependencies are declared with default (compile) scope on purpose.
         src/main/java is the framework core that ships in the published
         jar. src/test/java is a self-contained demo/regression suite that
         proves the framework works and doubles as CI verification for this
         repo itself - it is NOT shipped when other teams import this as a
         Maven dependency. Consuming projects only ever see src/main/java.
         =================================================================== -->
    <dependencies>

        <!-- Selenium WebDriver -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
        </dependency>

        <!-- Automatic browser driver resolution - no manual chromedriver/geckodriver setup -->
        <dependency>
            <groupId>io.github.bonigarcia</groupId>
            <artifactId>webdrivermanager</artifactId>
            <version>${webdrivermanager.version}</version>
        </dependency>

        <!-- Cucumber -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <version>${cucumber.version}</version>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
            <version>${cucumber.version}</version>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-picocontainer</artifactId>
            <version>${cucumber.version}</version>
        </dependency>

        <!-- JUnit 5 platform (runs the Cucumber suite + supports parallel/retry config) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <version>${junit.platform.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>${junit.platform.version}</version>
        </dependency>

        <!-- Reporting: Extent Reports (rich local HTML report + screenshots).
             This adapter pulls in com.aventstack:extentreports transitively and
             wires itself in automatically as soon as it's registered as a
             Cucumber plugin (see junit-platform.properties / extent.properties). -->
        <dependency>
            <groupId>tech.grasshopper</groupId>
            <artifactId>extentreports-cucumber7-adapter</artifactId>
            <version>${extent.adapter.version}</version>
        </dependency>

        <!-- Reporting: Allure (CI dashboards, history/trends) -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-cucumber7-jvm</artifactId>
            <version>${allure.version}</version>
        </dependency>
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
            <version>${aspectj.version}</version>
        </dependency>

        <!-- Logging: SLF4J API + Log4j2 backend, console + file, visible locally and in CI -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${log4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <version>${log4j.version}</version>
        </dependency>

        <!-- Config / JSON helpers -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>${commons.io.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
        </testResources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>${maven.resources.plugin.version}</version>
            </plugin>

            <!-- Runs the JUnit5/Cucumber suite. Retry count, parallelism and report
                 plugins are configured via src/test/resources/junit-platform.properties
                 so they apply the same locally and in CI. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.version}</version>
                <configuration>
                    <argLine>${argLine}</argLine>
                    <includes>
                        <include>**/Run*.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <browser>${browser}</browser>
                        <env>${env}</env>
                        <headless>${headless}</headless>
                    </systemPropertyVariables>
                    <testFailureIgnore>true</testFailureIgnore>
                </configuration>
            </plugin>

            <!-- Ship a sources jar - good practice for a library other teams import -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>${maven.source.plugin.version}</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven.jar.plugin.version}</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>${maven.deploy.plugin.version}</version>
            </plugin>

            <!-- `mvn versions:display-dependency-updates` to check for newer
                 library versions before bumping the properties above. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <version>${versions.plugin.version}</version>
            </plugin>
        </plugins>
    </build>

    <!-- ===================================================================
         Nexus coordinates. Server credentials (nexus-releases / nexus-snapshots)
         come from settings.xml (see settings.xml.sample) or CI secret
         variables - never commit credentials here.
         =================================================================== -->
    <distributionManagement>
        <repository>
            <id>nexus-releases</id>
            <name>Nexus Releases Repository</name>
            <url>${env.NEXUS_RELEASE_URL}</url>
        </repository>
        <snapshotRepository>
            <id>nexus-snapshots</id>
            <name>Nexus Snapshots Repository</name>
            <url>${env.NEXUS_SNAPSHOT_URL}</url>
        </snapshotRepository>
    </distributionManagement>

    <profiles>
        <!-- mvn test -Preport-allure -> serves the Allure report after the run -->
        <profile>
            <id>report-allure</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.qameta.allure</groupId>
                        <artifactId>allure-maven</artifactId>
                        <version>2.13.0</version>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
